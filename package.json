{
	"name": "js-library-browser",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"lint": "conc \"npm run lint:js\" \"npm run lint:html\" \"npm run lint:css\"",
		"lint:js": "npm run build -w @w0s/writing-mode && oxlint",
		"lint:html": "markuplint \"packages/**/*.html\"",
		"lint:css": "stylelint -f verbose \"packages/**/*.html\"",
		"pretest": "npm run build -w @w0s/writing-mode && npm run build --workspaces",
		"test": "conc \"npm run test:node\" \"npm run test:playwright\"",
		"test:node": "cross-env NODE_OPTIONS=--experimental-vm-modules jest \"packages/.+?/dist/.+\\.test\\.js\" -c jest.config.mjs",
		"test:playwright": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@types/node": "26.1.2",
		"@w0s/markuplint-config": "4.0.0-rc.2",
		"@w0s/oxlint-config": "1.0.7",
		"@w0s/stylelint-config": "4.24.0",
		"@w0s/tsconfig": "3.1.1",
		"concurrently": "10.0.5",
		"coveralls": "3.1.1",
		"cross-env": "10.1.0",
		"cross-fetch": "4.1.0",
		"eslint-plugin-playwright": "2.11.0",
		"http-server": "14.1.1",
		"jest": "30.5.1",
		"jest-environment-jsdom": "30.5.1",
		"jsdom-testing-mocks": "1.16.0",
		"markuplint": "5.0.0-rc.7",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-plugin-safely-storage": "1.0.0",
		"oxlint-tsgolint": "7.0.2001",
		"postcss-html": "2.0.0",
		"rimraf": "6.1.3",
		"stylelint": "17.14.1",
		"stylelint-attribute-case-sensitivity": "3.1.0",
		"stylelint-config-concentric-order": "5.5.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-no-default-viewport": "2.0.1",
		"stylelint-root-colors": "3.0.1",
		"typescript": "7.0.2"
	}
}
